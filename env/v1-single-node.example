# IBEX Harness — v1-single-node profile environment template (ADR-0097).
# This file is tracked and contains no secrets. `make v1-secrets` copies it to
# `infra/compose/v1-single-node/.env` (mode 0600) and fills the empty secret
# placeholders. That path is separate from the repository's development `.env`.
# Never commit `.env`; never share it; keep it 0600.
#
# Default posture is the self-contained smoke: staging + mock LLM. It proves the
# profile starts and serves the critical journey; it is not a production claim.
IBEX_ENV=staging
IBEX_LLM_MODE=mock
# Port 443 may require root/privileged binding. Set 8443 on a rootless runtime.
# Trust infra/compose/v1-single-node/secrets/ca.crt in the browser to avoid the
# self-signed warning at https://localhost:<IBEX_EDGE_PORT>.
IBEX_EDGE_PORT=443
IBEX_OPERATOR_FEATURE_ENABLED=true
# Derived by the generator from IBEX_EDGE_PORT. Do not set a second origin.
IBEX_ALLOWED_ORIGINS=https://localhost
POSTGRES_USER=ibex
POSTGRES_DB=ibex
NUXT_PUBLIC_IBEX_ENV=self-hosted

# Identity created once by the one-shot `bootstrap` service. The service prints
# IBEX_BOOTSTRAP_PAT=<token> exactly once; read it from the bootstrap logs.
IBEX_BOOTSTRAP_ORG_NAME=IBEX Harness
IBEX_BOOTSTRAP_ORG_SLUG=ibex
IBEX_BOOTSTRAP_USER_EMAIL=owner@ibex.local
IBEX_BOOTSTRAP_USER_NAME=Owner
IBEX_BOOTSTRAP_AGENT_NAME=Default Agent
IBEX_BOOTSTRAP_AGENT_SLUG=default
IBEX_BOOTSTRAP_PAT_NAME=Bootstrap PAT

# Secrets — left empty in this template and filled by `make v1-secrets`.
# Keep POSTGRES_PASSWORD and REDIS_PASSWORD URL-safe if you set them yourself:
# both are interpolated into Postgres DSNs and Redis URLs.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
IBEX_CREDENTIALS_MASTER_KEY=
IBEX_AUTH_SERVICE_TOKEN=
IBEX_CONTEXT_GRPC_SERVICE_TOKEN=
# The memory service authenticates inbound callers through AuthService. The
# generator writes a PAT-shaped service token here; the bootstrap inserts its
# hash as a scoped service_token (MemoryRead|MemoryWrite) so context and worker
# can call memory without an admin PAT. Changing it is applied by the next
# bootstrap run; a revoked service_token row is never reactivated.
IBEX_MEMORY_API_TOKEN=
IBEX_EMBEDDING_API_TOKEN=
IBEX_WORKER_ENQUEUE_API_TOKEN=
DASHBOARD_CSRF_SECRET=
IBEX_OPERATOR_CURSOR_SECRET=

# Production posture (commented): the mock LLM is a fixture, not a product, and
# an operator-supplied provider key (or a self-hosted LLM) is required. Uncomment
# these lines, set OPENAI_API_KEY, and restart the stack.
# IBEX_ENV=production
# IBEX_LLM_MODE=live
# OPENAI_API_KEY=
