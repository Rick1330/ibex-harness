{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibexharness.com/schemas/ranking-quality-benchmark-data.schema.json",
  "title": "Ranking-quality benchmark published data",
  "description": "Published ranking-quality history. schema_version stays 1 because the per-run provenance block is a widening: it is optional, so every document written before it existed still validates unchanged.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark", "runs"],
  "properties": {
    "schema_version": { "const": 1 },
    "benchmark": { "const": "ranking_quality" },
    "runs": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sha",
          "short_sha",
          "timestamp",
          "branch",
          "run_number",
          "run_url",
          "metrics",
          "status"
        ],
        "properties": {
          "sha": { "type": "string", "minLength": 7 },
          "short_sha": { "type": "string", "minLength": 7 },
          "timestamp": { "type": "string" },
          "branch": { "type": "string" },
          "run_number": { "type": "integer", "minimum": 0 },
          "run_url": { "type": "string" },
          "gold_set": { "type": "string" },
          "query_count": { "type": "integer", "minimum": 0 },
          "memory_count": { "type": "integer", "minimum": 0 },
          "metrics": {
            "type": "object",
            "required": ["precision_at_5", "recall_at_10", "mrr"],
            "properties": {
              "precision_at_5": { "type": "number", "minimum": 0, "maximum": 1 },
              "recall_at_10": { "type": "number", "minimum": 0, "maximum": 1 },
              "mrr": { "type": "number", "minimum": 0, "maximum": 1 },
              "expected_order_match": { "type": "number", "minimum": 0, "maximum": 1 },
              "top_category_accuracy": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          },
          "status": { "type": "string", "enum": ["pass", "fail"] },
          "gate_summary": { "type": "object" },
          "provenance": {
            "description": "Identity of the corpus and the runner. Optional so runs published before this block existed stay valid; status=recorded requires the full identity, including the gold set, because on this benchmark the gold set is the corpus.",
            "type": "object",
            "additionalProperties": false,
            "required": ["status"],
            "properties": {
              "status": {
                "type": "string",
                "enum": ["recorded", "unrecorded"]
              },
              "producer": { "type": "string", "minLength": 1 },
              "runner_cpu_model": { "type": "string", "minLength": 1 },
              "runner_cpu_count": { "type": "integer", "minimum": 1 },
              "runner_ram_mib": { "type": "integer", "minimum": 1 },
              "corpus_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "corpus_hash_algo": { "const": "sha256" },
              "corpus_manifest": { "type": "string", "minLength": 1 },
              "corpus_status": {
                "type": "string",
                "enum": ["current", "stale"]
              },
              "dirty": { "type": "boolean" },
              "seed": { "type": "integer" },
              "gold_set_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "gold_set_name": { "type": "string", "minLength": 1 }
            },
            "if": {
              "properties": { "status": { "const": "recorded" } },
              "required": ["status"]
            },
            "then": {
              "required": [
                "producer",
                "runner_cpu_model",
                "runner_cpu_count",
                "runner_ram_mib",
                "corpus_hash",
                "corpus_hash_algo",
                "corpus_manifest",
                "corpus_status",
                "dirty",
                "gold_set_hash",
                "gold_set_name"
              ]
            }
          }
        }
      }
    }
  }
}
