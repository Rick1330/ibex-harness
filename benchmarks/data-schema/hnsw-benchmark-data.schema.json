{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibexharness.com/schemas/hnsw-benchmark-data.schema.json",
  "title": "HNSW benchmark published data",
  "description": "Published HNSW recall/latency history. schema_version stays 1 because the per-run provenance block is a widening: it is optional, so every document written before it existed still validates unchanged.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark", "runs"],
  "properties": {
    "schema_version": { "const": 1 },
    "benchmark": { "const": "hnsw_recall_latency" },
    "runs": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sha",
          "short_sha",
          "timestamp",
          "branch",
          "run_number",
          "run_url",
          "methodology",
          "results",
          "mean_recall_at_10"
        ],
        "properties": {
          "sha": { "type": "string", "minLength": 7 },
          "short_sha": { "type": "string", "minLength": 7 },
          "timestamp": { "type": "string" },
          "branch": { "type": "string" },
          "run_number": { "type": "integer", "minimum": 0 },
          "run_url": { "type": "string" },
          "methodology": { "type": "object" },
          "mean_recall_at_10": { "type": "number", "minimum": 0, "maximum": 1 },
          "status": {
            "type": "string",
            "enum": ["pass", "fail", "warn"]
          },
          "gate_summary": {
            "type": "object",
            "additionalProperties": true
          },
          "provenance": {
            "description": "Identity of the corpus and the runner. Optional so runs published before this block existed stay valid; status=recorded requires the full identity.",
            "type": "object",
            "additionalProperties": false,
            "required": ["status"],
            "properties": {
              "status": {
                "type": "string",
                "enum": ["recorded", "unrecorded"]
              },
              "producer": { "type": "string", "minLength": 1 },
              "runner_cpu_model": { "type": "string", "minLength": 1 },
              "runner_cpu_count": { "type": "integer", "minimum": 1 },
              "runner_ram_mib": { "type": "integer", "minimum": 1 },
              "corpus_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "corpus_hash_algo": { "const": "sha256" },
              "corpus_manifest": { "type": "string", "minLength": 1 },
              "corpus_status": {
                "type": "string",
                "enum": ["current", "stale"]
              },
              "dirty": { "type": "boolean" },
              "seed": { "type": "integer" }
            },
            "if": {
              "properties": { "status": { "const": "recorded" } },
              "required": ["status"]
            },
            "then": {
              "required": [
                "producer",
                "runner_cpu_model",
                "runner_cpu_count",
                "runner_ram_mib",
                "corpus_hash",
                "corpus_hash_algo",
                "corpus_manifest",
                "corpus_status",
                "dirty"
              ]
            }
          },
          "results": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "corpus_size",
                "query_count",
                "recall_at_10",
                "latency_ms_p50",
                "latency_ms_p95",
                "latency_ms_p99",
                "ef_search"
              ],
              "properties": {
                "corpus_size": { "type": "integer", "minimum": 1 },
                "query_count": { "type": "integer", "minimum": 1 },
                "recall_at_10": { "type": "number", "minimum": 0, "maximum": 1 },
                "latency_ms_p50": { "type": "number", "minimum": 0 },
                "latency_ms_p95": { "type": "number", "minimum": 0 },
                "latency_ms_p99": { "type": "number", "minimum": 0 },
                "latency_ms_p95_ci_low": { "type": "number", "minimum": 0 },
                "latency_ms_p95_ci_high": { "type": "number", "minimum": 0 },
                "ef_search": { "type": "integer", "minimum": 1 },
                "min_similarity": { "type": "number", "minimum": 0, "maximum": 1 },
                "iterative_scan": {
                  "type": "string",
                  "enum": ["off", "relaxed_order", "strict_order"]
                },
                "index_build_mode": {
                  "type": "string",
                  "enum": ["incremental", "bulk"]
                },
                "plan_node_type": { "type": "string" },
                "plan_index_name": { "type": "string" },
                "shared_hit_blocks": { "type": "integer", "minimum": 0 },
                "shared_read_blocks": { "type": "integer", "minimum": 0 },
                "idx_scan_delta": { "type": "integer", "minimum": 0 },
                "row_count_verified": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    }
  }
}
