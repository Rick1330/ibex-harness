{
  // Handwritten markdown is linted in CI via ci-gate-repo (markdownlint job).
  // Generated or machine-owned paths are excluded here so release and bot PRs
  // are not blocked by formatting the pipeline cannot control.
  "config": {
    "default": true,
    "MD013": false,
    "MD022": false,
    "MD024": false,
    "MD029": false,
    "MD032": false,
    "MD033": false,
    "MD036": false,
    "MD041": false,
    "MD056": false,
    "MD060": false,
    "MD010": false,
    "MD025": { "front_matter_title": "" }
  },
  "overrides": [
    {
      // Docus MDC component property blocks use `---` fences and indented
      // component bodies that markdownlint parses as headings/code blocks.
      // Nuxt Content build and `pnpm site:check` validate this tree.
      "filter": ["site/content/**/*.md"],
      "combine": "merge",
      "config": {
        "MD003": false,
        "MD046": false
      }
    }
  ],
  "globs": ["**/*.md", "**/*.mdc"],
  "ignores": [
    "node_modules/**",
    "**/node_modules/**",
    ".git/**",
    ".venv/**",
    "**/.venv/**",
    "**/site-packages/**",
    // Nuxt build output and tool caches are generated.
    "site/.output/**",
    "site/.nuxt/**",
    "site/.data/**",
    "site/test-results/**",
    "site/playwright-report/**",
    // Root changelog is generated by the version release pipeline (release-please).
    "CHANGELOG.md",
    // Local research drafts (gitignored); never committed.
    "new findings/**",
    // Operator platform research archive — imported audit provenance with bare URLs
    // and reference blocks; roadmap/engineering pages are the linted source of truth.
    "engineering/research/**"
  ]
}
