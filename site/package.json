{
  "name": "site",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "node scripts/build-releases.mjs && nuxt dev",
    "build": "node scripts/build-releases.mjs && nuxt build",
    "generate": "node scripts/build-releases.mjs && nuxt generate",
    "typecheck": "node scripts/build-releases.mjs && nuxt typecheck",
    "releases": "node scripts/build-releases.mjs",
    "preview": "nuxt preview",
    "lint": "eslint .",
    "check:links": "node scripts/check-links.mjs",
    "check:redirects": "node scripts/check-redirects.mjs",
