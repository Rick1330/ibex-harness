  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "better-sqlite3": "12.11.1",
    "docus": "5.15.0",
    "mermaid": "12.2.0",
    "nuxt": "4.6.2"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@playwright/test": "1.62.1",
    "eslint": "10.13.0",
    "typescript": "5.9.3",
    "vue-tsc": "3.1.4",
    "yaml": "2.9.1"
  }
}
