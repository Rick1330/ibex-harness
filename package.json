{
  "name": "ibex-harness",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "docs:dev": "turbo dev --filter=docs",
    "docs:dev:clean": "pnpm --filter docs dev:clean",
    "docs:build": "turbo build --filter=docs",
    "docs:build:clean": "pnpm --filter docs build:clean",
    "docs:start": "pnpm --filter docs start",
    "docs:measure": "pnpm --filter docs measure:payload"
  },
  "devDependencies": {
    "turbo": "^2.5.4"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.28.1",
      "postcss": ">=8.5.10",
      "dompurify": ">=3.4.11"
    }
  }
}
