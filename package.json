{
  "name": "ibex-harness",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "site:dev": "turbo dev --filter=site",
    "site:build": "turbo build --filter=site",
    "site:build:clean": "pnpm --filter site build",
    "site:start": "pnpm --filter site preview",
    "site:lint": "pnpm --filter site lint",
    "site:typecheck": "pnpm --filter site typecheck",
    "site:check": "pnpm --filter site check:claims && pnpm --filter site check:links && pnpm --filter site check:redirects",
    "docs:dev": "pnpm site:dev",
    "docs:build": "pnpm site:build",
    "docs:build:clean": "pnpm site:build:clean",
    "docs:start": "pnpm site:start"
  },
  "devDependencies": {
    "dompurify": "3.4.17",
    "sharp": "0.35.5",
    "turbo": "^2.10.9",
    "undici": "8.12.3",
    "wrangler": "4.151.3"
  },
  "pnpm": {
    "overrides": {
      "@modelcontextprotocol/sdk": ">=1.31.0",
      "body-parser": ">=2.4.0 <3",
      "dompurify": ">=3.4.17",
      "esbuild": ">=0.28.1",
      "fast-uri": ">=3.1.9 <4",
      "hono": ">=4.13.11",
      "ip-address": ">=10.7.4",
      "js-yaml": ">=4.3.2 <5",
      "nanoid": ">=3.3.17 <4",
      "postcss": ">=8.5.23",
      "serialize-javascript": ">=7.1.3",
      "sharp": ">=0.35.0",
      "undici": ">=7.30.1",
      "vite": ">=8.2.4 <9",
      "yaml": ">=2.8.3 <3",
      "browserslist": "4.28.7",
      "katex": "0.18.2",
      "postcss-selector-parser": "7.1.6",
      "source-map-js": "1.2.2"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp",
      "@parcel/watcher",
      "unrs-resolver"
    ]
  }
}
