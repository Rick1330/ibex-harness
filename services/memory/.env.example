# Memory substrate service (Phase 3 / m3.2.1 bootstrap)
# Local default is loopback. Containers must set IBEX_MEMORY_HOST=0.0.0.0 explicitly.
IBEX_MEMORY_HOST=127.0.0.1
IBEX_MEMORY_PORT=8005

# Async Postgres (required for PgVectorStore — PR-B)
# IBEX_MEMORY_DATABASE_URL=postgresql+asyncpg://ibex:ibex@127.0.0.1:5432/ibex

IBEX_MEMORY_VECTOR_SEARCH_MIN_SIMILARITY=0.70
IBEX_HNSW_EF_SEARCH=40

IBEX_RANK_WEIGHT_RELEVANCE=0.40
IBEX_RANK_WEIGHT_RECENCY=0.25
IBEX_RANK_WEIGHT_USEFULNESS=0.20
IBEX_RANK_WEIGHT_CONFIDENCE=0.10
IBEX_RANK_WEIGHT_FREQUENCY=0.05

# Embedder HTTP client (PR-C)
IBEX_MEMORY_EMBEDDING_BASE_URL=http://127.0.0.1:8004
# IBEX_EMBEDDING_API_TOKEN=

# PII stage (m3.C.1 / ADR-0054) — separate from injection quarantine threshold
IBEX_MEMORY_MAX_CONTENT_CHARS=10000
IBEX_MEMORY_PII_REDACT_MIN_CONFIDENCE=0.70
IBEX_MEMORY_PII_SPACY_MODEL=en_core_web_md

# Dedup stages (m3.C.2 / ADR-0055)
IBEX_MEMORY_DEDUP_EXACT_ENABLED=true
IBEX_MEMORY_NEAR_DUPLICATE_SIM_THRESHOLD=0.92
IBEX_MEMORY_NEAR_DUPLICATE_CANDIDATE_LIMIT=10
