# =============================================================================
# IBEX Auth Service — Environment Variables
# Reference only: the auth service does not load .env files. Export values into its process environment.
# Full registry: engineering/ENVIRONMENT_VARIABLES.md §10
# =============================================================================

# ── Required ─────────────────────────────────────────────────────────────────

# deployment profile: development | staging | production (REQUIRED — no default;
# startup fails if this is unset or empty)
IBEX_ENV=development

# PostgreSQL DSN (lib/pq format)
POSTGRES_DSN=

# Redis for revocation PUBLISH + ValidateToken peer rate limit (same instance as proxy).
# Empty → no pub/sub (LRU TTL fallback) and no ValidateToken RPM enforcement (private-network assumption).
REDIS_URL=

# Per-proxy-host ValidateToken calendar-minute cap when REDIS_URL is set (default: 6000).
# Aggregate across all tokens from that host — size to peak legitimate proxy RPS×60.
IBEX_AUTH_VALIDATE_RPM=6000

# ── Optional ─────────────────────────────────────────────────────────────────

# logical service name for logs and metrics (default: auth)
IBEX_SERVICE_NAME=auth

# HTTP listen port for /health, /ready, /metrics (default: 8081)
IBEX_PORT=8081

# gRPC listen port for AuthService (default: 9091)
IBEX_GRPC_PORT=9091

# graceful shutdown drain timeout (default: 30s)
IBEX_SHUTDOWN_TIMEOUT=30s

# Argon2id parameters for PAT hashing (defaults match ADR-0010 production profile)
IBEX_ARGON2_MEMORY_KIB=65536
IBEX_ARGON2_TIME=3
IBEX_ARGON2_PARALLELISM=4

# JWT session signing key (PEM RSA private key). Required when TOTP/session
# issuance is enabled.
# JWT_PRIVATE_KEY_PEM=
# File-backed equivalent: a Compose .env cannot carry a multi-line PEM.
# Used only when JWT_PRIVATE_KEY_PEM is empty.
# JWT_PRIVATE_KEY_FILE=

# Base64 32-byte KEK for org provider API keys (required when IBEX_ENV=production).
# Generate: openssl rand -base64 32
# IBEX_CREDENTIALS_MASTER_KEY=
# IBEX_CREDENTIALS_MASTER_KEY_ID=v1

# Policy snapshot signing (GAP-002). PEM RSA private key (PKCS#1 or PKCS#8,
# >= 2048 bits) used to mint policy-snapshot.v1 envelopes. Required outside
# development; when unset, IssuePolicySnapshot fails closed with
# FailedPrecondition and the proxy verifier must be configured with the
# matching public key (IBEX_PROXY_POLICY_PUBLIC_KEYS).
# Generate: openssl genrsa 2048 | openssl pkcs8 -topk8 -nocrypt
# IBEX_AUTH_POLICY_SIGNING_KEY_PEM=
# File-backed equivalent, used only when IBEX_AUTH_POLICY_SIGNING_KEY_PEM is empty.
# IBEX_AUTH_POLICY_SIGNING_KEY_FILE=
# IBEX_AUTH_POLICY_SIGNING_KEY_ID=v1
# IBEX_AUTH_POLICY_EPOCH=1

# ── Observability ────────────────────────────────────────────────────────────

OTEL_SERVICE_NAME=ibex-auth
OTEL_SERVICE_VERSION=dev
OTEL_DEPLOYMENT_ENVIRONMENT=development
# leave empty to disable OTLP export in local dev
# Local LGTM stack (make observability-up): OTEL_EXPORTER_OTLP_ENDPOINT=127.0.0.1:4317
# (host:port only — no http:// scheme for OTLP gRPC)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SAMPLE_RATIO=1.0

# ── Development convenience ──────────────────────────────────────────────────

# DEBUG | INFO | WARN | ERROR (default: INFO)
IBEX_LOG_LEVEL=debug

# AuthService gRPC server TLS (ADR-0097 §4): server certificate and private key
# PEM. Both empty is allowed ONLY in development; exactly one is an error; outside
# development the pair is required and the gRPC port serves TLS. The certificate
# must be currently valid and carry a DNS or IP subject alternative name.
# Generate a per-install pair with: bash infra/scripts/gen-v1-tls.sh
# IBEX_AUTH_GRPC_TLS_CERT_FILE=
# IBEX_AUTH_GRPC_TLS_KEY_FILE=
