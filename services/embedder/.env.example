# IBEX Embedder — local environment
# Copy: cp services/embedder/.env.example services/embedder/.env

IBEX_EMBEDDING_PROFILE=cpu
IBEX_EMBEDDING_API_TOKEN=dev-embedder-metrics-token
IBEX_EMBEDDING_CACHE_ENABLED=false

# Optional geometry overrides (must match profile defaults unless migrating):
# IBEX_EMBEDDING_MODEL=all-MiniLM-L6-v2
# IBEX_EMBEDDING_DIM=384

# TEI (gpu profile):
# IBEX_EMBEDDING_PROFILE=gpu
# IBEX_EMBEDDING_TEI_BASE_URL=http://127.0.0.1:8080
# IBEX_EMBEDDING_TEI_ALLOW_INSECURE=true

# Hosted (hosted profile):
# IBEX_EMBEDDING_PROFILE=hosted
# IBEX_EMBEDDING_HOSTED_PROVIDER=openai
# IBEX_EMBEDDING_HOSTED_API_KEY=

# Prometheus scrape uses Bearer IBEX_EMBEDDING_API_TOKEN (see infra/compose/observability).
# Listen: uvicorn app.main:app --host 127.0.0.1 --port 8004
