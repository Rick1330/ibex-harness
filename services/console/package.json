{
  "name": "@ibex/console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "IBEX Console: Nuxt 4 operator application with a server-only operator BFF, explicit live/preview status, and no fabricated tenant data.",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "start": "node .output/server/index.mjs",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test -c playwright.config.ts",
    "test:e2e:live": "playwright test -c playwright.live.config.ts",
    "check:surfaces": "vitest run tests/surface-status.test.ts tests/preview-policy.test.ts",
    "lint": "nuxt prepare && eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@lucide/vue": "1.62.0",
    "@nuxtjs/color-mode": "^3.5.2",
    "@tabler/icons-vue": "^3.49.0",
    "@tanstack/vue-table": "^8.21.3",
    "@unovis/vue": "^1.7.1",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "nuxt": "4.6.3",
    "reka-ui": "^2.11.0",
    "shadcn-nuxt": "^2.8.2",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^26.4.1",
    "axe-core": "4.13.0",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.13"
  }
}
