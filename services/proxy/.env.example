# =============================================================================
# IBEX Proxy Service — Environment Variables
# Copy to .env: cp services/proxy/.env.example services/proxy/.env
# Full registry: web/engineering/ENVIRONMENT_VARIABLES.md §9
# =============================================================================

# ── Required ─────────────────────────────────────────────────────────────────

# Redis URL (rate limiting + auth-cache revocation SUBSCRIBE; required for auth cache wrap)
REDIS_URL=

# gRPC address of auth service (host:port)
IBEX_AUTH_GRPC_ADDR=127.0.0.1:9091

# Postgres for directive reads + session lifecycle (m2.3.2 / m2.4.2 / m2.4.3).
# Directive cache also needs REDIS_URL. Session hot path: GetOrCreate + async checkpoints
# when DSN is set; Redis session cache when REDIS_URL is set.
# POSTGRES_DSN=postgres://ibex:ibex@localhost:5432/ibex?sslmode=disable
# IBEX_DIRECTIVE_CACHE_TTL=60s
# IBEX_SESSION_CACHE_TTL=60s
# IBEX_SESSION_CHECKPOINT_WORKERS=8
# IBEX_SESSION_CHECKPOINT_QUEUE=256
# IBEX_SESSION_GETORCREATE_TIMEOUT=50ms
# IBEX_SESSION_IDLE_TIMEOUT=45m
# IBEX_SESSION_SWEEP_INTERVAL=1m

# Idempotency-Key Redis dedupe for non-streaming chat (m2.1.6). Requires REDIS_URL.
# IBEX_IDEMPOTENCY_TTL=24h
# IBEX_IDEMPOTENCY_REDIS_TIMEOUT=50ms

# ClickHouse llm_traces batch writer (m2.5.2). Optional until async emitter (2.5.3).
# CLICKHOUSE_DSN=clickhouse://default:@localhost:8123/ibex
# CLICKHOUSE_INSERT_BATCH_SIZE=500
# CLICKHOUSE_INSERT_FLUSH_MS=200

# ── Optional ─────────────────────────────────────────────────────────────────

IBEX_ENV=development
IBEX_SERVICE_NAME=proxy

# HTTP listen port (default: 8080)
IBEX_PORT=8080

IBEX_SHUTDOWN_TIMEOUT=30s

# per-call auth ValidateToken deadline (production target: 50ms; local dev: 2s)
IBEX_AUTH_VALIDATE_TIMEOUT=2s

# Auth cache (bloom of invalids + claims LRU); see ADR-0028 / ADR-0029.
# Wrap requires REDIS_URL and a successful Redis Ping for the revocation channel;
# otherwise the proxy logs WARN and leaves ValidateToken uncached (immediate revoke).
IBEX_AUTH_CACHE_ENABLED=true
# IBEX_AUTH_CACHE_LRU_CAPACITY=5000
# IBEX_AUTH_CACHE_LRU_MAX_TTL=30s
# IBEX_AUTH_CACHE_BLOOM_EXPECTED_ITEMS=10000
# IBEX_AUTH_CACHE_BLOOM_FP_RATE=0.001

# max chat request body bytes (default: 1048576)
IBEX_MAX_REQUEST_BODY_BYTES=1048576

IBEX_REQUEST_ID_HEADER=X-Request-ID
IBEX_TRACE_ID_HEADER=X-Trace-ID

# default org rate limit RPM (default: 60)
IBEX_RATE_LIMIT_DEFAULT_RPM=60

# comma-separated org_uuid=rpm overrides
IBEX_RATE_LIMIT_ORG_OVERRIDES=

# optional base URL for error envelope docs_url
IBEX_ERROR_DOCS_BASE=

# ── Observability ────────────────────────────────────────────────────────────

OTEL_SERVICE_NAME=ibex-proxy
OTEL_SERVICE_VERSION=dev
OTEL_DEPLOYMENT_ENVIRONMENT=development
# Local LGTM stack (make observability-up): OTEL_EXPORTER_OTLP_ENDPOINT=127.0.0.1:4317
# (host:port only — no http:// scheme for OTLP gRPC)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SAMPLE_RATIO=1.0

# ── LLM provider (Phase 2 / 2.5) ─────────────────────────────────────────────

# mock = in-process stub provider (immediate JSON/SSE); live = register configured vendors
# Smoke expects 200 under mock. Rejected when IBEX_ENV=production (fail closed).
# Live requires OPENAI_API_KEY and/or ANTHROPIC_API_KEY (ADR-0026, ADR-0040).
IBEX_LLM_MODE=mock

# OpenAI (or OpenAI-compatible) — register when set in live mode
OPENAI_API_KEY=

# Optional OpenAI overrides (see ADR-0026)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_REQUEST_TIMEOUT=120s
# OPENAI_MAX_RETRIES=3
# OPENAI_RETRY_BASE_DELAY=500ms

# Extra OpenAI allowlist model IDs (comma-separated). Example OpenRouter:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# IBEX_LLM_EXTRA_MODELS=openai/gpt-oss-20b:free
# Every ExtraModels ID also needs a capability overlay (ADR-0041):
# IBEX_MODEL_CAPABILITY_OVERLAYS=[{"model_id":"openai/gpt-oss-20b:free","provider":"openai","context_window":8192,"max_output_tokens":2048,"supports_tools":false,"supports_vision":false,"supports_streaming":true,"tokenizer_family":"unknown"}]
# IBEX_LLM_EXTRA_MODELS=

# Anthropic Messages API — register when set in live mode (ADR-0040)
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_REQUEST_TIMEOUT=120s
# ANTHROPIC_MAX_RETRIES=3
# ANTHROPIC_RETRY_BASE_DELAY=500ms
# ANTHROPIC_EXTRA_MODELS=
# IBEX_MODEL_CAPABILITY_OVERLAYS=

# Self-hosted OpenAI-compatible (vLLM / TGI / Ollama) — ADR-0042
# IBEX_SELFHOSTED_ENABLED=true
# IBEX_SELFHOSTED_BASE_URL=http://127.0.0.1:8000/v1
# IBEX_SELFHOSTED_MODELS=local-llama
# IBEX_SELFHOSTED_API_KEY=
# IBEX_SELFHOSTED_READY_TIMEOUT=60s
# IBEX_SELFHOSTED_READY_POLL=2s
# IBEX_PROVIDER_CIRCUIT_BREAKER_FAILURES=5
# IBEX_PROVIDER_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30
# Overlay provider stays "openai" (wire dialect); runtime provider name is openaicompatible:
# IBEX_MODEL_CAPABILITY_OVERLAYS=[{"model_id":"local-llama","provider":"openai","context_window":8192,"max_output_tokens":2048,"supports_tools":false,"supports_vision":false,"supports_streaming":true,"tokenizer_family":"unknown"}]

# ── Development convenience ──────────────────────────────────────────────────

IBEX_LOG_LEVEL=debug

# Smoke test script only (not read by proxy binary):
# IBEX_PROXY_ADDR=http://localhost:8080
# IBEX_DEV_TOKEN=ibex_pat_00000000-0000-0000-0000-000000000004_LOCALDEVELOPMENTONLY
# IBEX_DEV_AGENT_ID=00000000-0000-0000-0000-000000000003
# IBEX_DEV_ORG_ID=00000000-0000-0000-0000-000000000001
