# MCP memory resource server (G6.M1). Copy to .env for local runs.

IBEX_ENV=development
IBEX_MCP_TRANSPORT=streamable_http
IBEX_MCP_ALLOW_STDIO=false
# Local default is loopback. Containers must set IBEX_MCP_HOST=0.0.0.0 explicitly.
IBEX_MCP_HOST=127.0.0.1
IBEX_MCP_PORT=8090
IBEX_MCP_RESOURCE_URL=http://127.0.0.1:8090/mcp
IBEX_MCP_AUTH_SERVER_URL=http://127.0.0.1:8080
IBEX_AUTH_GRPC_ADDR=127.0.0.1:9091
IBEX_MCP_AUTH_TIMEOUT_MS=50
IBEX_MCP_CLICKHOUSE_URL=http://127.0.0.1:8123
IBEX_MCP_AUDIT_QUEUE_SIZE=1024
