# MCP operator gateway (GAP-009). Copy to .env for local runs.
# The gateway is inert unless IBEX_MCP_OPERATOR_ENABLED=true.

IBEX_ENV=development
IBEX_MCP_OPERATOR_ENABLED=false
# Streamable HTTP only; stdio is not implemented by this service.
# Local default is loopback. Containers must set IBEX_MCP_OPERATOR_HOST=0.0.0.0 explicitly.
IBEX_MCP_OPERATOR_HOST=127.0.0.1
IBEX_MCP_OPERATOR_PORT=8091
IBEX_MCP_OPERATOR_RESOURCE_URL=http://127.0.0.1:8091/mcp
IBEX_MCP_OPERATOR_AUTH_SERVER_URL=http://127.0.0.1:8080
IBEX_AUTH_GRPC_ADDR=127.0.0.1:9091
IBEX_MCP_OPERATOR_AUTH_TIMEOUT_MS=50

# Required when enabled. Reads run as ibex_app with app.current_org_id bound (RLS).
IBEX_MCP_OPERATOR_DATABASE_URL=postgresql+asyncpg://ibex_app:ibex_app@127.0.0.1:5432/ibex
# Required in staging/production; empty → Noop allow-all limiter (development only).
IBEX_MCP_OPERATOR_REDIS_URL=redis://127.0.0.1:6379/0
IBEX_MCP_OPERATOR_RATE_LIMIT_RPM=120
# IBEX_MCP_OPERATOR_RATE_LIMIT_ORG_OVERRIDES=aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa=60

# Audit sink. Empty → structured logs only (metadata, never content).
IBEX_MCP_OPERATOR_CLICKHOUSE_URL=http://default:ibexdev@127.0.0.1:8123
IBEX_MCP_OPERATOR_AUDIT_QUEUE_SIZE=1024
