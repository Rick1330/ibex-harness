# =============================================================================
# IBEX Relay Service — Environment Variables (GAP-011, issue #1002)
# Copy to .env: cp services/relay/.env.example services/relay/.env
# Full registry: engineering/ENVIRONMENT_VARIABLES.md §10b
# =============================================================================

# ── Gate (default-off) ───────────────────────────────────────────────────────

# The relay is inert unless explicitly enabled. Disabled exits 0 without
# connecting to anything. Enabling requires both DSNs below and fails closed
# (exit 1) when either is missing or unreachable.
IBEX_RELAY_ENABLED=false

# Runtime profile is always explicit: development | staging | production
IBEX_ENV=development

# ── Required when enabled ────────────────────────────────────────────────────

# PostgreSQL outbox authority. The daemon pins role ibex_evidence_relay per
# connection and asserts current_user at startup. The login role must be a
# member of ibex_evidence_relay (deployment prerequisite; role is NOLOGIN).
# IBEX_RELAY_POSTGRES_DSN=postgres://relay_login:password@localhost:5432/ibex?sslmode=disable

# ClickHouse projection sink (non-production pilot; G4-gated). Use the native
# protocol port (9000); http(s):// DSNs select the HTTP protocol instead.
# IBEX_RELAY_CLICKHOUSE_DSN=clickhouse://default:@localhost:9000/ibex

# ── Tuning (bounds enforced at startup) ──────────────────────────────────────

# IBEX_RELAY_POLL_INTERVAL=2s       # 500ms–5m
# IBEX_RELAY_BATCH_SIZE=32          # 1–256
# IBEX_RELAY_MAX_ATTEMPTS=8         # 1–100
# IBEX_RELAY_RECOVER_AFTER=60s      # 1s–1h
# IBEX_RELAY_OPERATION_TIMEOUT=30s  # 1s–5m
# IBEX_RELAY_ERROR_BACKOFF=5s       # 500ms–1m (doubles, capped at 1m; max IBEX_RELAY_ERROR_BACKOFF is 1m)

# ── Shared process settings ──────────────────────────────────────────────────

IBEX_SERVICE_NAME=relay

# HTTP listen port (default: 8081; /health, /ready, /metrics)
IBEX_PORT=8081

IBEX_SHUTDOWN_TIMEOUT=30s

# ── Development convenience ──────────────────────────────────────────────────

IBEX_LOG_LEVEL=debug
