{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "ibex-harness values",
  "type": "object",
  "required": ["images", "proxy", "deployment"],
  "properties": {
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile"],
      "properties": {
        "profile": { "type": "string", "enum": ["development", "staging", "production"] }
      }
    },
    "images": {
      "type": "object",
      "required": [
        "proxy",
        "auth",
        "api",
        "worker",
        "memory",
        "embedder",
        "mcpMemory"
      ],
      "properties": {
        "proxy": { "$ref": "#/definitions/digestPinnedImage" },
        "auth": { "$ref": "#/definitions/digestPinnedImage" },
        "api": { "$ref": "#/definitions/digestPinnedImage" },
        "worker": { "$ref": "#/definitions/digestPinnedImage" },
        "memory": { "$ref": "#/definitions/digestPinnedImage" },
        "embedder": { "$ref": "#/definitions/digestPinnedImage" },
        "mcpMemory": { "$ref": "#/definitions/digestPinnedImage" },
        "migrate": {
          "type": "string",
          "pattern": "^.+@sha256:[a-f0-9]{64}$",
          "not": {
            "pattern": "@sha256:0{64}$"
          }
        }
      },
      "additionalProperties": true
    },
    "migrate": {
      "type": "object",
      "required": ["enabled", "externalMechanism"],
      "properties": {
        "enabled": { "type": "boolean" },
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "externalMechanism": { "type": "string", "enum": ["ci-job", "operator-runbook", "none"] }
      }
    },
    "ingress": {
      "type": "object",
      "required": ["enabled", "className", "host", "tlsSecretName", "annotations"],
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "host": { "type": "string" },
        "tlsSecretName": { "type": "string" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "proxy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "redis"],
      "properties": {
        "environment": { "type": "string", "enum": ["development", "staging", "production"] },
        "llm": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "provider", "secretName", "apiKeyKey"],
          "properties": {
            "mode": { "type": "string", "enum": ["mock", "live"] },
            "provider": { "type": "string", "enum": ["openai"] },
            "secretName": { "type": "string", "minLength": 1 },
            "apiKeyKey": { "type": "string", "minLength": 1 }
          }
        },
        "redis": {
          "type": "object",
          "additionalProperties": false,
          "required": ["secretName", "urlKey"],
          "properties": {
            "secretName": { "type": "string", "minLength": 1 },
            "urlKey": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "worker": {
      "type": "object",
      "properties": {
        "enqueue": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "secretName": { "type": "string", "minLength": 1 },
            "redisUrlKey": { "type": "string", "minLength": 1 },
            "enqueueTokenKey": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "postgres": {
          "type": "object",
          "required": ["name", "dsnKey", "migrateDsnKey"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "dsnKey": { "type": "string", "minLength": 1 },
            "migrateDsnKey": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "deployment": { "properties": { "profile": { "const": "development" } } }
        }
      },
      "then": {
        "properties": {
          "proxy": { "properties": { "environment": { "const": "development" } } }
        }
      }
    },
    {
      "if": {
        "properties": {
          "deployment": { "properties": { "profile": { "const": "staging" } } }
        }
      },
      "then": {
        "properties": {
          "proxy": { "properties": { "environment": { "const": "staging" } } }
        }
      }
    },
    {
      "if": {
        "properties": {
          "deployment": { "properties": { "profile": { "const": "production" } } }
        }
      },
      "then": {
        "properties": {
          "proxy": { "properties": { "environment": { "const": "production" } } }
        }
      }
    },
    {
      "if": {
        "properties": {
          "deployment": { "properties": { "profile": { "const": "production" } } },
          "migrate": { "properties": { "enabled": { "const": false } } }
        }
      },
      "then": {
        "properties": {
          "migrate": {
            "properties": {
              "externalMechanism": { "enum": ["ci-job", "operator-runbook"] }
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "digestPinnedImage": {
      "type": "string",
      "pattern": "^.+@sha256:[a-f0-9]{64}$",
      "not": {
        "pattern": "@sha256:0{64}$"
      }
    }
  }
}
