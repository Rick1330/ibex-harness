{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "ibex-harness values",
  "type": "object",
  "required": ["images", "proxy", "deployment"],
  "properties": {
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile"],
      "properties": {
        "profile": { "type": "string", "enum": ["development", "staging", "production"] }
      }
    },
    "images": {
      "type": "object",
      "required": [
        "proxy",
        "auth",
        "api",
        "worker",
        "memory",
        "embedder",
        "mcpMemory"
      ],
      "properties": {
        "proxy": { "$ref": "#/definitions/digestPinnedImage" },
        "auth": { "$ref": "#/definitions/digestPinnedImage" },
        "api": { "$ref": "#/definitions/digestPinnedImage" },
        "worker": { "$ref": "#/definitions/digestPinnedImage" },
        "memory": { "$ref": "#/definitions/digestPinnedImage" },
        "embedder": { "$ref": "#/definitions/digestPinnedImage" },
        "mcpMemory": { "$ref": "#/definitions/digestPinnedImage" },
        "migrate": {
          "type": "string",
          "pattern": "^.+@sha256:[a-f0-9]{64}$",
          "not": {
            "pattern": "@sha256:0{64}$"
          }
        }
      },
      "additionalProperties": true
    },
    "migrate": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "backoffLimit": { "type": "integer", "minimum": 0 }
      }
    },
    "proxy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "redis"],
      "properties": {
        "environment": { "type": "string", "enum": ["development", "staging", "production"] },
        "redis": {
          "type": "object",
          "additionalProperties": false,
          "required": ["secretName", "urlKey"],
          "properties": {
            "secretName": { "type": "string", "minLength": 1 },
            "urlKey": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "worker": {
      "type": "object",
      "properties": {
        "enqueue": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "secretName": { "type": "string", "minLength": 1 },
            "redisUrlKey": { "type": "string", "minLength": 1 },
            "enqueueTokenKey": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "deployment": { "properties": { "profile": { "const": "development" } } }
        }
      },
      "then": {
        "properties": {
          "proxy": { "properties": { "environment": { "const": "development" } } }
        }
      }
    },
    {
      "if": {
        "properties": {
          "deployment": { "properties": { "profile": { "const": "staging" } } }
        }
      },
      "then": {
        "properties": {
          "proxy": { "properties": { "environment": { "const": "staging" } } }
        }
      }
    },
    {
      "if": {
        "properties": {
          "deployment": { "properties": { "profile": { "const": "production" } } }
        }
      },
      "then": {
        "properties": {
          "proxy": { "properties": { "environment": { "const": "production" } } }
        }
      }
    }
  ],
  "definitions": {
    "digestPinnedImage": {
      "type": "string",
      "pattern": "^.+@sha256:[a-f0-9]{64}$",
      "not": {
        "pattern": "@sha256:0{64}$"
      }
    }
  }
}
