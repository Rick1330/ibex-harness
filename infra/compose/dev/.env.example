# IBEX Harness — local dev compose (infra/compose/dev)
# Copy to .env for overrides: cp .env.example .env
# Do not commit .env with production secrets.

POSTGRES_USER=ibex
POSTGRES_PASSWORD=ibex
POSTGRES_DB=ibex
POSTGRES_PORT=5432

REDIS_PORT=6379

CLICKHOUSE_DB=ibex
CLICKHOUSE_USER=default
# Non-empty password required for host access (empty password → default user is localhost-only).
CLICKHOUSE_PASSWORD=ibexdev
CLICKHOUSE_HTTP_PORT=8123
# Host port for ClickHouse native protocol (container listens on 9000; avoids clash with MinIO API on 9000)
CLICKHOUSE_NATIVE_HOST_PORT=9002
CLICKHOUSE_DSN=clickhouse://default:ibexdev@localhost:8123/ibex
# Native TCP for golang-migrate (host maps container 9000 → 9002). Quote required: unquoted & is job control.
CLICKHOUSE_MIGRATE_DSN="clickhouse://default:ibexdev@localhost:9002?database=ibex&x-multi-statement=true&x-migrations-table-engine=MergeTree"

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Application DSNs (for services; not used by compose itself)
REDIS_URL=redis://localhost:6379/0
POSTGRES_DSN=postgresql+asyncpg://ibex:ibex@localhost:5432/ibex
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_SESSIONS=ibex-sessions
S3_BUCKET_EXPORTS=ibex-exports
