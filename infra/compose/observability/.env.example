# Local-only observability stack (ADR-0051). Not for production secrets.
IBEX_OBS_GRAFANA_ADMIN_PASSWORD=ibex-local-only
IBEX_OBS_PROMETHEUS_PORT=19090
IBEX_OBS_GRAFANA_PORT=3000
IBEX_OBS_TEMPO_PORT=3200
IBEX_OBS_LOKI_PORT=3100
IBEX_OBS_ALERTMANAGER_PORT=9093
IBEX_OBS_OTLP_GRPC_PORT=4317
IBEX_OBS_OTLP_HTTP_PORT=4318
IBEX_OBS_OTEL_HEALTH_PORT=13133

# Scrape bearer for embedder /metrics (must match IBEX_EMBEDDING_API_TOKEN on the embedder process).
IBEX_EMBEDDING_METRICS_BEARER=dev-embedder-metrics-token

# Host ports where IBEX services publish /metrics (host.docker.internal from containers).
IBEX_PROXY_METRICS_HOST=host.docker.internal:8080
IBEX_AUTH_METRICS_HOST=host.docker.internal:8081
IBEX_EMBEDDER_METRICS_HOST=host.docker.internal:8004
IBEX_MCP_METRICS_HOST=host.docker.internal:8090
